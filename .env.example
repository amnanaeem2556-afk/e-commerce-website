# Environment variables example
GEMINI_API_KEY=
FRONTEND_URL=http://localhost:3000

# Email Provider Configuration (Specify one of: Resend, Brevo, SendGrid, or SMTP)
# 1. Resend (Recommended: https://resend.com)
RESEND_API_KEY=

# 2. Brevo / Sendinblue (https://brevo.com)
BREVO_API_KEY=

# 3. SendGrid (https://sendgrid.com)
SENDGRID_API_KEY=

# 4. Custom SMTP (e.g., Gmail App Password, AWS SES, Mailgun)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Verified Sender Email & Name (e.g., "Lumora Haute Couture <onboarding@resend.dev>" or "orders@lumora.luxury")
EMAIL_FROM=
